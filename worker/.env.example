# Copy to worker/.env for local runs (devops/provision.sh infra writes this file for you).
# In Azure these come from Container App secrets / env vars instead.
DATABASE_URL="postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/marathon_pulse?sslmode=require"
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"
BLOB_CONTAINER_NAME="excel-uploads"
QUEUE_NAME="excel-jobs"

# Tuning (all optional)
BATCH_SIZE=1000
MAX_ATTEMPTS=3
VISIBILITY_TIMEOUT_SECONDS=600
CLAIM_STALE_SECONDS=300
RETRY_DELAY_SECONDS=30
