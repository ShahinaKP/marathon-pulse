# Copy to worker/.env for local runs (devops/provision.sh infra writes this file for you).
# In Azure these come from Container App secrets / env vars instead.
DATABASE_URL="postgresql://<user>:<password>@<server>.postgres.database.azure.com:5432/marathon_pulse?sslmode=require"
AZURE_STORAGE_CONNECTION_STRING="DefaultEndpointsProtocol=https;AccountName=<account>;AccountKey=<key>;EndpointSuffix=core.windows.net"
BLOB_CONTAINER_NAME="excel-uploads"
QUEUE_NAME="excel-jobs"

# Tuning (all optional; defaults shown)
BATCH_SIZE=1000                 # rows per DB flush and progress update
MAX_CONCURRENT_JOBS=1           # jobs processed in parallel inside one replica
MAX_ATTEMPTS=3                  # processing attempts per job before it is FAILED
VISIBILITY_TIMEOUT_SECONDS=90   # queue lease; renewed while a job runs
LEASE_RENEW_SECONDS=20          # how often a running job renews its lease + heartbeat
CLAIM_STALE_SECONDS=60          # heartbeat age after which another worker may take a job over
RETRY_DELAY_SECONDS=30          # retry delay = this x attempts used
POISON_QUEUE_NAME="excel-jobs-poison"
# CHAOS_CRASH_AFTER_ROWS=20000   # DEMO ONLY (off when unset): hard-crash once mid-job to prove recovery
